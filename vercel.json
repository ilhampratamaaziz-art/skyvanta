{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/wilayah.json",
      "dest": "server.js"
    },
    {
      "src": "/(.*\\.(js|css|png|svg|ico|mp4|webp|jpg|jpeg|gif|woff2|woff|ttf))",
      "dest": "public/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=3600"
      }
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}

